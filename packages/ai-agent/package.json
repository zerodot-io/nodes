{
  "name": "@zerodot/ai-agent",
  "version": "0.3.0",
  "description": "An AI agent with ports for a chat model, memory, and tools. Chat models of OpenAI, Anthropic, Google Gemini, Mistral, Groq, xAI, DeepSeek, OpenRouter, Ollama, Azure OpenAI, Amazon Bedrock, Google Vertex AI, or any OpenAI-compatible endpoint, memory in a data table, and other workflows, MCP servers, and vector stores as tools. Embedding models, text splitters, a data loader, and a Cohere reranker for vector stores.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodot-io/nodes.git",
    "directory": "packages/ai-agent"
  },
  "keywords": [
    "zerodot-node-package"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": "./dist/index.cjs"
  },
  "files": [
    "dist",
    "ai-agent.svg",
    "ai.svg",
    "memory.svg",
    "workflow.svg",
    "mcp.svg",
    "code.svg",
    "memory-manager.svg",
    "openai.svg",
    "anthropic.svg",
    "gemini.svg",
    "splitter.svg",
    "document.svg",
    "reranker.svg",
    "vector-store.svg",
