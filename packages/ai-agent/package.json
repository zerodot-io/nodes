    "groq.svg",
    "xai.svg",
    "deepseek.svg",
    "openrouter.svg",
    "ollama.svg",
    "azure.svg",
    "bedrock.svg",
    "vertex.svg"
  ],
  "zerodot": {
    "sdk": "^1.5",
    "label": "AI Agent",
    "summary": "An AI agent with ports for a chat model, memory, and tools"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json",
