{
  "name": "@zerodot/ai",
  "version": "1.1.0",
  "description": "Generate text, embeddings, images, and audio with OpenAI, Anthropic, Google Gemini, Mistral, Groq, xAI, DeepSeek, OpenRouter, Ollama, Azure OpenAI, Amazon Bedrock, Google Vertex AI, or any OpenAI-compatible endpoint, in one node. Use it to add AI steps to a workflow.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodot-io/nodes.git",
    "directory": "packages/ai"
  },
  "keywords": [
    "zerodot-node-package"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": "./dist/index.cjs"
  },
  "files": [
    "dist",
    "ai.svg"
  ],
  "zerodot": {
    "sdk": "^1.2",
    "label": "AI",
    "summary": "Text, images, audio, and embeddings from many AI providers"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.118",
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/azure": "4.0.104",
    "@ai-sdk/deepseek": "3.0.67",
    "@ai-sdk/google": "4.0.99",
    "@ai-sdk/google-vertex": "5.0.115",
    "@ai-sdk/groq": "4.0.63",
    "@ai-sdk/mistral": "4.0.66",
    "@ai-sdk/openai": "4.0.96",
    "@ai-sdk/openai-compatible": "3.0.71",
    "@ai-sdk/xai": "5.0.24",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.143"
  },
  "peerDependencies": {
    "@zerodot/node-sdk": "^1.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@zerodot/ai-core": "workspace:*",
    "@zerodot/node-sdk": "^1.2.1",
    "tsdown": "0.23.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
