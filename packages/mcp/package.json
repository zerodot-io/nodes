{
  "name": "@zerodot/mcp",
  "version": "1.1.2",
  "description": "Call a tool on an MCP server over Streamable HTTP, and use the result in your workflow. Use it to connect to any service that has an MCP server.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodot-io/nodes.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "zerodot-node-package"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": "./dist/index.cjs"
  },
  "files": [
    "dist",
    "mcp.svg"
  ],
  "zerodot": {
    "sdk": "^1.2",
    "label": "MCP Call Tool",
    "summary": "Call tools on an MCP server"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "peerDependencies": {
    "@zerodot/node-sdk": "^1.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@zerodot/node-sdk": "^1.4.0",
    "tsdown": "0.23.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
