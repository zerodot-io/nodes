{
  "name": "@zerodot/s3",
  "version": "1.0.0",
  "description": "S3 node for zerodot: buckets and objects on Amazon S3 and S3-compatible services.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodot-io/zerodot-nodes.git",
    "directory": "packages/s3"
  },
  "keywords": [
    "zerodot-node-package"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
