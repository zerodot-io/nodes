  },
  "keywords": [
    "zerodot-node-package"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": "./dist/index.cjs"
  },
  "files": [
    "dist",
    "meta.svg"
  ],
  "zerodot": {
    "sdk": "^1.2",
    "label": "Meta",
    "summary": "Publish to Instagram, Facebook Pages, and Threads"
  },
  "scripts": {
