{
  "name": "@zerodot/mysql",
  "version": "1.1.1",
  "description": "Run SQL queries on a MySQL database, or insert, update, select, and delete rows. Use it to read and write the data of your app in MySQL.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodot-io/nodes.git",
    "directory": "packages/mysql"
  },
  "keywords": [
    "zerodot-node-package"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": "./dist/index.cjs"
  },
  "files": [
    "dist",
    "mysql.svg"
  ],
  "zerodot": {
    "sdk": "^1.1",
    "label": "MySQL",
    "summary": "Queries and rows in MySQL"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "mysql2": "3.24.6"
  },
  "peerDependencies": {
    "@zerodot/node-sdk": "^1.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@zerodot/node-sdk": "^1.2.1",
    "tsdown": "0.23.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
