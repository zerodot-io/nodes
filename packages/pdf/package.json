{
  "name": "@zerodot/pdf",
  "version": "1.0.1",
  "description": "Work with PDF files: read the text and page count, merge files, pick pages, split a file, and rotate pages. Use it to prepare or read documents in a workflow.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodot-io/nodes.git",
    "directory": "packages/pdf"
  },
  "keywords": [
    "zerodot-node-package"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": "./dist/index.cjs"
  },
  "files": [
    "dist",
    "pdf.svg"
  ],
  "zerodot": {
    "sdk": "^1.1",
    "label": "PDF",
    "summary": "Read text, merge, split, and rotate PDF files"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "unpdf": "1.8.1"
  },
  "peerDependencies": {
    "@zerodot/node-sdk": "^1.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@zerodot/node-sdk": "^1.2.1",
    "tsdown": "0.23.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
