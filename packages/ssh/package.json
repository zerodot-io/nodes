{
  "name": "@zerodot/ssh",
  "version": "1.1.0",
  "description": "Run commands on a server over SSH, and list, download, upload, rename, and delete files over FTP and SFTP. Use it to manage servers and to move files.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodot-io/zerodot-nodes.git",
    "directory": "packages/ssh"
  },
  "keywords": [
    "zerodot-node-package"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": "./dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "zerodot": {
    "sdk": "^1.1",
    "label": "SSH, FTP and SFTP",
    "summary": "Remote commands and file transfer"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "basic-ftp": "6.2.3",
    "ssh2": "1.17.0"
  },
  "peerDependencies": {
    "@zerodot/node-sdk": "^1.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ssh2": "1.15.6",
    "@zerodot/node-sdk": "^1.1.1",
    "tsdown": "0.23.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
