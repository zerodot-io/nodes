{
  "name": "@zerodot/telegram",
  "version": "1.0.0",
  "description": "Send messages and files with a Telegram bot, and start a workflow when the bot gets a message or other update. Use it to build chat bots and notifications.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodot-io/zerodot-nodes.git",
    "directory": "packages/telegram"
  },
  "keywords": [
    "zerodot-node-package"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "telegram.svg"
  ],
  "zerodot": {
    "sdk": "^1.2",
    "label": "Telegram"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "peerDependencies": {
    "@zerodot/node-sdk": "^1.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@zerodot/node-sdk": "^1.2.0",
    "tsdown": "0.23.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
