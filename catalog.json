        {
          "type": "trigger.slack",
          "label": "Slack Trigger",
          "description": "Start the workflow on a Slack event, such as a message or a mention"
        },
        {
          "type": "slack.api",
          "label": "Slack",
          "description": "Send messages, manage channels, find users, and upload files with a Slack bot"
        }
      ]
    },
    {
      "name": "@zerodot/ssh",
