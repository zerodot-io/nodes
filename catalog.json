{
  "version": 1,
  "packages": [
    {
      "name": "@zerodot/discord",
      "label": "Discord",
      "summary": "Bot messages, webhooks, and slash commands",
      "description": "Send, edit, and react to messages, manage channels, members, and roles with a Discord bot, post with a webhook, and start a workflow on a slash command or a button click. Use it to build Discord bots, alerts, and moderation flows.",
      "version": "1.0.0",
      "sdk": "^1.2",
      "icon": "MessageCircle",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "trigger.discord",
          "label": "Discord Trigger",
          "description": "Start the workflow on a slash command, button click, or modal of a Discord app"
        },
        {
          "type": "discord.api",
          "label": "Discord",
          "description": "Send messages and manage channels and members with a Discord bot or webhook"
        }
      ]
    },
    {
      "name": "@zerodot/edit-image",
      "label": "Edit Image",
      "summary": "Resize, crop, rotate, and convert images",
      "description": "Change an image: get its size, resize, crop, rotate, blur, make it gray, or convert it to JPEG, PNG, WebP, or AVIF. Use it to prepare images before you upload or send them.",
      "version": "1.1.0",
      "sdk": "^1.1",
      "icon": "Image",
      "nodes": [
        {
          "type": "file.edit_image",
          "label": "Edit Image",
          "description": "Resize, crop, rotate, blur, or convert an image"
        }
      ]
    },
    {
      "name": "@zerodot/email",
      "label": "Email",
      "summary": "Send email and react to new mail",
      "description": "Send email through an SMTP server, and start a workflow when a new email arrives in an IMAP mailbox. Use it for notifications and reports, or to react to incoming mail.",
      "version": "1.1.0",
      "sdk": "^1.1",
      "icon": "Mail",
      "nodes": [
        {
          "type": "email.send",
          "label": "Send Email",
          "description": "Sends an email using SMTP protocol"
        },
        {
          "type": "trigger.email_imap",
          "label": "On new email (IMAP)",
          "description": "Start a run when a new unread mail arrives in a mailbox"
        }
      ]
    },
    {
      "name": "@zerodot/github",
      "label": "GitHub",
      "summary": "Issues, repos, files, and webhook triggers",
      "description": "Work with issues, repositories, files, and releases on GitHub, and start a workflow on an event in a repository, such as a push or a new issue. Use it to automate your development work.",
      "version": "1.1.0",
      "sdk": "^1.1",
      "icon": "GitBranch",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "trigger.github",
          "label": "GitHub Trigger",
          "description": "Start the workflow on an event in a GitHub repository"
        },
        {
          "type": "github.api",
          "label": "GitHub",
          "description": "Work with issues, repositories, files, and releases on GitHub"
        }
      ]
    },
    {
      "name": "@zerodot/google-sheets",
      "label": "Google Sheets",
      "summary": "Read and write rows in spreadsheets",
      "description": "Read, append, update, and delete rows in Google Sheets, with a header row that maps each row to an object. Create spreadsheets and tabs, and clear ranges. Connect with Google sign-in or a service account.",
      "version": "1.0.0",
      "sdk": "^1.2",
      "icon": "Sheet",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "google_sheets.api",
          "label": "Google Sheets",
          "description": "Read, append, and update rows in Google Sheets"
        }
      ]
    },
    {
      "name": "@zerodot/mcp",
      "label": "MCP Call Tool",
      "summary": "Call tools on an MCP server",
      "description": "Call a tool on an MCP server over Streamable HTTP, and use the result in your workflow. Use it to connect to any service that has an MCP server.",
      "version": "1.1.0",
      "sdk": "^1.1",
      "icon": "Plug",
      "nodes": [
        {
          "type": "mcp.call_tool",
          "label": "MCP Call Tool",
          "description": "Call a tool on an MCP server"
        }
      ]
    },
    {
      "name": "@zerodot/mongodb",
      "label": "MongoDB",
      "summary": "Documents in MongoDB",
      "description": "Find, insert, update, delete, and aggregate documents in a MongoDB collection. Use it to read and write the data of your app in MongoDB.",
      "version": "1.1.0",
      "sdk": "^1.1",
      "icon": "Database",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "mongodb.documents",
          "label": "MongoDB",
          "description": "Find, insert, update, delete, and aggregate documents in MongoDB"
        }
      ]
    },
    {
      "name": "@zerodot/mysql",
      "label": "MySQL",
      "summary": "Queries and rows in MySQL",
