      "version": "1.1.0",
      "sdk": "^1.1",
      "icon": "HardDrive",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "s3.storage",
          "label": "S3",
          "description": "Work with buckets and objects in Amazon S3 and S3-compatible storage"
        }
      ]
    },
    {
      "name": "@zerodot/slack",
      "label": "Slack",
      "summary": "Messages, channels, files, and Slack events",
