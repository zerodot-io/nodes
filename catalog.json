{
  "version": 1,
  "packages": [
    {
      "name": "@zerodot/edit-image",
      "label": "Edit Image",
      "summary": "Resize, crop, rotate, and convert images",
      "description": "Change an image: get its size, resize, crop, rotate, blur, make it gray, or convert it to JPEG, PNG, WebP, or AVIF. Use it to prepare images before you upload or send them.",
      "version": "1.1.1",
      "sdk": "^1.1",
      "icon": "Image01Icon",
      "nodes": [
        {
          "type": "file.edit_image",
          "label": "Edit Image",
          "description": "Resize, crop, rotate, blur, or convert an image"
        }
      ]
    },
    {
      "name": "@zerodot/email",
      "label": "Email",
      "summary": "Send email and react to new mail",
      "description": "Send email through an SMTP server, and start a workflow when a new email arrives in an IMAP mailbox. Use it for notifications and reports, or to react to incoming mail.",
      "version": "1.1.1",
      "sdk": "^1.1",
      "icon": "Mail01Icon",
      "nodes": [
        {
          "type": "email.send",
          "label": "Send Email",
          "description": "Sends an email using SMTP protocol"
        },
        {
          "type": "trigger.email_imap",
          "label": "On new email (IMAP)",
          "description": "Start a run when a new unread mail arrives in a mailbox"
        }
      ]
    },
    {
      "name": "@zerodot/gmail",
      "label": "Gmail",
      "summary": "Send, read, and label emails in Gmail",
      "description": "Send, reply to, and draft emails in Gmail. Read, search, label, trash, and delete messages and threads, with attachments as binary data. A trigger starts a run for each new email that matches a query. Connect with Google sign-in or a service account.",
      "version": "1.0.1",
      "sdk": "^1.2",
      "icon": "Mail01Icon",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "gmail.api",
          "label": "Gmail",
          "description": "Send, read, search, and label emails in Gmail"
        },
        {
          "type": "gmail.trigger",
          "label": "On new email (Gmail)",
          "description": "Start a run when a new email matches a search or a label"
        }
      ]
    },
    {
      "name": "@zerodot/google-drive",
      "label": "Google Drive",
      "summary": "Find, upload, download, and share files",
      "description": "Find, upload, download, copy, move, delete, and share files and folders in Google Drive. Start a workflow when a file is new or changed. Connect with Google sign-in or a service account.",
      "version": "1.0.1",
      "sdk": "^1.2",
      "icon": "HardDriveIcon",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "trigger.google_drive",
          "label": "On Google Drive file change",
          "description": "Check Google Drive on a timer and start a run for each new or changed file"
        },
        {
          "type": "google_drive.api",
          "label": "Google Drive",
          "description": "Find, upload, download, and share files in Google Drive"
        }
      ]
    },
    {
      "name": "@zerodot/google-sheets",
      "label": "Google Sheets",
      "summary": "Read and write rows in spreadsheets",
      "description": "Read, append, update, and delete rows in Google Sheets, with a header row that maps each row to an object. Create spreadsheets and tabs, and clear ranges. Connect with Google sign-in or a service account.",
      "version": "1.0.1",
      "sdk": "^1.2",
      "icon": "Table01Icon",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "google_sheets.api",
          "label": "Google Sheets",
          "description": "Read, append, and update rows in Google Sheets"
        }
      ]
    },
    {
      "name": "@zerodot/linear",
      "label": "Linear",
      "summary": "Issues, comments, projects, and webhook triggers",
      "description": "Work with issues, comments, projects, teams, and cycles in Linear, and start a workflow on an event, such as a new issue or comment. Use it to automate your product work.",
      "version": "1.0.1",
      "sdk": "^1.1",
      "icon": "CheckListIcon",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "trigger.linear",
          "label": "Linear Trigger",
          "description": "Start the workflow on an event in Linear"
        },
        {
          "type": "linear.api",
          "label": "Linear",
          "description": "Work with issues, comments, projects, teams, and cycles in Linear"
        }
      ]
    },
    {
      "name": "@zerodot/mcp",
      "label": "MCP Call Tool",
      "summary": "Call tools on an MCP server",
      "description": "Call a tool on an MCP server over Streamable HTTP, and use the result in your workflow. Use it to connect to any service that has an MCP server.",
      "version": "1.1.1",
      "sdk": "^1.2",
      "icon": "PlugSocketIcon",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "mcp.call_tool",
          "label": "MCP Call Tool",
          "description": "Call a tool on an MCP server"
        }
      ]
    },
    {
      "name": "@zerodot/s3",
      "label": "S3",
      "summary": "Files and buckets in S3 and compatible storage",
      "description": "Manage buckets and files in Amazon S3 or in an S3-compatible service such as MinIO or Cloudflare R2: upload, download, list, and delete objects, and make signed links. Use it to store and share files.",
      "version": "1.1.1",
      "sdk": "^1.1",
      "icon": "HardDriveIcon",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "s3.storage",
          "label": "S3",
          "description": "Work with buckets and objects in Amazon S3 and S3-compatible storage"
        }
      ]
    }
  ]
}
