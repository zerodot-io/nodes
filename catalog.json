      "version": "1.0.1",
      "sdk": "^1.1",
      "icon": "FileText",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "file.pdf",
          "label": "PDF",
          "description": "Read text, merge, split, and rotate PDF files"
        }
      ]
    },
    {
      "name": "@zerodot/postgres",
      "label": "Postgres",
      "summary": "Queries, rows, and change triggers for Postgres",
      "description": "Run SQL queries on a Postgres database, or insert, update, select, and delete rows. Start a workflow when a new row appears or when Postgres sends a notification. Use it to read and write your app data.",
      "version": "1.1.0",
      "sdk": "^1.1",
      "icon": "Database",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "postgres.database",
          "label": "Postgres",
          "description": "Get, add and update data in Postgres"
        },
        {
          "type": "trigger.postgres",
          "label": "On new Postgres row",
          "description": "Check a table on a timer and start a run for each new row"
        },
        {
          "type": "trigger.postgres_listen",
          "label": "On Postgres event",
          "description": "Start a run at once when a row is added, changed or removed"
        }
      ]
    },
    {
      "name": "@zerodot/redis",
      "label": "Redis",
      "summary": "Keys, lists, and messages in Redis",
