      "icon": "Send",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "trigger.telegram",
          "label": "Telegram Trigger",
          "description": "Start the workflow on a Telegram bot update"
        },
        {
          "type": "telegram.bot",
          "label": "Telegram",
          "description": "Send messages and manage chats with a Telegram bot"
