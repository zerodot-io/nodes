      "version": "1.1.0",
      "sdk": "^1.1",
      "icon": "Database",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "mysql.database",
          "label": "MySQL",
          "description": "Get, add and update data in MySQL"
        }
      ]
    },
    {
      "name": "@zerodot/pdf",
      "label": "PDF",
