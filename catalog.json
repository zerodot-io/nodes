      "version": "1.1.0",
      "sdk": "^1.0",
      "icon": "Database",
      "iconUrl": "data:image/svg+xml;base64,",
      "nodes": [
        {
          "type": "redis.database",
          "label": "Redis",
          "description": "Get, set and delete keys, work on lists, and publish messages in Redis"
        },
        {
          "type": "trigger.redis",
          "label": "On Redis message",
          "description": "Start a run when a message arrives on a Redis channel"
        }
      ]
    },
    {
      "name": "@zerodot/s3",
      "label": "S3",
      "summary": "Files and buckets in S3 and compatible storage",
